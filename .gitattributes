# Detect text files without rewriting unrelated tracked content.
* text=auto

# Keep project source files consistent across Windows, macOS and Linux.
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.txt text eol=lf

# Explicitly identify common binary formats so Git never alters them.
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.gz binary

# A local virtual environment should not be versioned or normalised.
/.venv/** -text
